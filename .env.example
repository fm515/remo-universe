# REMO UNIVERSE — environment configuration
#
# The foundation build needs NO environment variables.
#
# Rules for later stages:
#   * Anything prefixed with VITE_ is bundled into the public client. Treat it as PUBLIC.
#   * Never put API keys, service-role keys, or private keys in a VITE_ variable.
#   * Secrets belong in server-side functions (see docs/ROADMAP.md), never in this repo.

# Public Supabase browser configuration (publishable key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
