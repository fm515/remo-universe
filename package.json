{
  "name": "remo-universe",
  "private": true,
  "version": "0.2.0",
  "description": "REMO UNIVERSE — modular, bilingual (AR/EN) PWA foundation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run check:boundaries && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
